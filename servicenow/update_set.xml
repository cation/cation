<?xml version="1.0" encoding="UTF-8"?>
<!--
  ServiceNow Update Set — User Phone Info UI Page
  Import via: System Update Sets > Retrieved Update Sets > Import Update Set from XML

  Before importing, replace every occurrence of 'your.property.name'
  with the actual sys_property key you want to display.
-->
<unload unload_date="2026-04-29 00:00:00">

  <!-- ================================================================
       1. UI Page record  (sys_ui_page)
       Navigate to: System UI > UI Pages  after import to test it.
       Direct URL:  /user_phone_info.do
       ================================================================ -->
  <sys_ui_page action="INSERT_OR_UPDATE">
    <sys_id>1f8d3a0e4b2c7e9d0f1a3b5c7e9d1f8a</sys_id>
    <sys_created_by>admin</sys_created_by>
    <sys_created_on>2026-04-29 00:00:00</sys_created_on>
    <sys_updated_by>admin</sys_updated_by>
    <sys_updated_on>2026-04-29 00:00:00</sys_updated_on>
    <sys_scope display_value="Global">global</sys_scope>
    <name>user_phone_info</name>
    <description>Displays a sys_property value and the logged-in user&apos;s phone number.</description>
    <direct>false</direct>
    <category>general</category>

    <!-- ── HTML (Jelly) ─────────────────────────────────────────── -->
    <html><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">

<style>
  .snc-info-page {
    font-family: "Source Sans Pro", Arial, sans-serif;
    max-width: 640px;
    margin: 32px auto;
    padding: 0 16px;
  }
  .snc-info-page h1 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 24px;
    color: #293e40;
  }
  .snc-info-card {
    border: 1px solid #d9e2e8;
    border-radius: 4px;
    padding: 20px 24px;
    margin-bottom: 20px;
    background: #ffffff;
  }
  .snc-info-card h2 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 14px;
    color: #293e40;
    border-bottom: 1px solid #e8ecee;
    padding-bottom: 10px;
  }
  .snc-field-row {
    display: flex;
    align-items: baseline;
    margin-bottom: 10px;
    font-size: 0.9rem;
  }
  .snc-field-label {
    color: #637887;
    min-width: 140px;
    flex-shrink: 0;
  }
  .snc-field-value {
    color: #293e40;
    font-weight: 500;
    word-break: break-word;
  }
  .snc-field-value.empty {
    color: #9aabba;
    font-style: italic;
    font-weight: normal;
  }
</style>

<div class="snc-info-page">
  <h1>System &amp;amp; User Information</h1>

  <div class="snc-info-card">
    <h2>System Property</h2>
    <div class="snc-field-row">
      <span class="snc-field-label">Property name</span>
      <span class="snc-field-value">your.property.name</span>
    </div>
    <div class="snc-field-row">
      <span class="snc-field-label">Value</span>
      <j:set var="jv_prop_value" value="${gs.getProperty('your.property.name', '')}"/>
      <j:choose>
        <j:when test="${empty(jv_prop_value)}">
          <span class="snc-field-value empty">(not set)</span>
        </j:when>
        <j:otherwise>
          <span class="snc-field-value">${jv_prop_value}</span>
        </j:otherwise>
      </j:choose>
    </div>
  </div>

  <div class="snc-info-card">
    <h2>Logged-in User</h2>
    <div class="snc-field-row">
      <span class="snc-field-label">Name</span>
      <span class="snc-field-value">${gs.getUserDisplayName()}</span>
    </div>
    <div class="snc-field-row">
      <span class="snc-field-label">Username</span>
      <span class="snc-field-value">${gs.getUserName()}</span>
    </div>
    <div class="snc-field-row">
      <span class="snc-field-label">Phone</span>
      <j:set var="jv_phone" value="${gs.getUser().getPhone()}"/>
      <j:choose>
        <j:when test="${empty(jv_phone)}">
          <span class="snc-field-value empty">(not set)</span>
        </j:when>
        <j:otherwise>
          <span class="snc-field-value">${jv_phone}</span>
        </j:otherwise>
      </j:choose>
    </div>
  </div>
</div>

</j:jelly>]]></html>

    <!-- ── Client Script (optional — only needed for GlideAjax variant) ── -->
    <client_script><![CDATA[]]></client_script>

    <!-- ── Processing Script (server-side JS alternative to Jelly) ─────── -->
    <processing_script><![CDATA[]]></processing_script>
  </sys_ui_page>

  <!-- ================================================================
       2. Script Include  (sys_script_include)
       Used only if you prefer the GlideAjax approach over Jelly.
       See script_include.js in this repo for the matching client code.
       ================================================================ -->
  <sys_script_include action="INSERT_OR_UPDATE">
    <sys_id>2e9c4b1d5a3f8e0c2d4b6a8e0c2d4b6a</sys_id>
    <sys_created_by>admin</sys_created_by>
    <sys_created_on>2026-04-29 00:00:00</sys_created_on>
    <sys_updated_by>admin</sys_updated_by>
    <sys_updated_on>2026-04-29 00:00:00</sys_updated_on>
    <sys_scope display_value="Global">global</sys_scope>
    <name>UserPhoneInfoAjax</name>
    <api_name>global.UserPhoneInfoAjax</api_name>
    <description>GlideAjax helper for user_phone_info UI page. Returns the logged-in user&apos;s phone and a sys_property value.</description>
    <access>public</access>
    <active>true</active>
    <script><![CDATA[var UserPhoneInfoAjax = Class.create();
UserPhoneInfoAjax.prototype = Object.extendsObject(AbstractAjaxProcessor, {

    getUserPhone: function () {
        return gs.getUser().getPhone() || '';
    },

    getSysProperty: function () {
        var propName = this.getParameter('sysparm_prop_name') || '';
        if (!propName) {
            return '';
        }
        return gs.getProperty(propName, '') || '';
    },

    type: 'UserPhoneInfoAjax'
});]]></script>
  </sys_script_include>

</unload>
