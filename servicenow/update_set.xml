<?xml version="1.0" encoding="UTF-8"?>
<!--
  ServiceNow Update Set — User Phone Info UI Page
  Import via: System Update Sets > Retrieved Update Sets > Import Update Set from XML

  Before importing:
  1. Replace every 'your.property.name' with your actual sys_property key.
  2. Ensure the sys_property record exists with its VALUE set to a
     sys_user field name, e.g.:
       Name:  your.property.name
       Value: u_mobile_phone      (or 'phone', 'mobile_phone', any string field)
-->
<unload unload_date="2026-04-29 00:00:00">

  <!-- ================================================================
       1. UI Page  (sys_ui_page)
       Opened by the UI Action below via g_modal.showFrame().
       The caller_id from the Incident is passed as sysparm_caller_id.

       How it works:
         - Reads sysparm_caller_id from the URL (validated as a sys_id).
         - Looks up the caller's name/username from sys_user.
         - Queries sys_dictionary for phone/mobile/telephone fields and
           renders them as a dropdown, pre-selecting the sys_property value.
         - Changing the dropdown previews the caller's value via GlideAjax.
         - Submit calls submitPhoneField(userId, fieldName) server-side.
       ================================================================ -->
  <sys_ui_page action="INSERT_OR_UPDATE">
    <sys_id>1f8d3a0e4b2c7e9d0f1a3b5c7e9d1f8a</sys_id>
    <sys_created_by>admin</sys_created_by>
    <sys_created_on>2026-04-29 00:00:00</sys_created_on>
    <sys_updated_by>admin</sys_updated_by>
    <sys_updated_on>2026-04-29 00:00:00</sys_updated_on>
    <sys_scope display_value="Global">global</sys_scope>
    <name>user_phone_info</name>
    <description>Opened from the Incident form; reads sysparm_caller_id from the URL and displays a phone-field selector for that caller&apos;s sys_user record.</description>
    <direct>false</direct>
    <category>general</category>

    <html><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">

<style>
  .snc-info-page {
    font-family: "Source Sans Pro", Arial, sans-serif;
    max-width: 640px;
    margin: 32px auto;
    padding: 0 16px;
  }
  .snc-info-page h1 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 24px;
    color: #293e40;
  }
  .snc-info-card {
    border: 1px solid #d9e2e8;
    border-radius: 4px;
    padding: 20px 24px;
    margin-bottom: 20px;
    background: #ffffff;
  }
  .snc-info-card h2 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 14px;
    color: #293e40;
    border-bottom: 1px solid #e8ecee;
    padding-bottom: 10px;
  }
  .snc-field-row {
    display: flex;
    align-items: baseline;
    margin-bottom: 12px;
    font-size: 0.9rem;
  }
  .snc-field-label {
    color: #637887;
    min-width: 160px;
    flex-shrink: 0;
  }
  .snc-field-value {
    color: #293e40;
    font-weight: 500;
    word-break: break-word;
  }
  .snc-field-value.empty {
    color: #9aabba;
    font-style: italic;
    font-weight: normal;
  }
  #phone-field-select {
    border: 1px solid #c0cdd6;
    border-radius: 3px;
    padding: 5px 8px;
    font-size: 0.9rem;
    min-width: 260px;
    color: #293e40;
  }
  #preview-row { display: none; }
  .snc-submit-btn {
    background: #1d7fca;
    color: #fff;
    border: none;
    border-radius: 3px;
    padding: 8px 20px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    margin-top: 4px;
  }
  .snc-submit-btn:hover { background: #1669a8; }
  .snc-submit-btn:disabled { background: #9aabba; cursor: not-allowed; }
  #submit-result { display: none; }
  .snc-result-success { border-color: #3d8b3d; }
  .snc-result-success h2 { color: #3d8b3d; }
  .snc-result-error { border-color: #b0321b; }
  .snc-result-error h2 { color: #b0321b; }
</style>

<g:evaluate var="jv_caller_id">
  var raw = RP.getParameterValue('sysparm_caller_id') || '';
  (/^[0-9a-f]{32}$/.test(raw)) ? raw : '';
</g:evaluate>

<g:evaluate var="jv_caller_name">
  var id = '${jv_caller_id}';
  if (!id) {
    jelly.put('jv_caller_username', '');
    '';
  } else {
    var gr = new GlideRecord('sys_user');
    if (gr.get(id)) {
      jelly.put('jv_caller_username', gr.getValue('user_name') || '');
      gr.getDisplayValue('name') || '';
    } else {
      jelly.put('jv_caller_username', '');
      '';
    }
  }
</g:evaluate>

<g:evaluate var="jv_phone_field">
  gs.getProperty('your.property.name', 'phone');
</g:evaluate>

<g:evaluate var="jv_select_options">
  var currentField = '${jv_phone_field}';
  var gr = new GlideRecord('sys_dictionary');
  gr.addQuery('name', 'sys_user');
  gr.addQuery('internal_type', 'string');
  var qc = gr.addQuery('column_label', 'CONTAINS', 'phone');
  qc.addOrCondition('column_label', 'CONTAINS', 'mobile');
  qc.addOrCondition('column_label', 'CONTAINS', 'telephone');
  gr.orderBy('column_label');
  gr.query();

  var html = '';
  var foundCurrent = false;
  while (gr.next()) {
    var fieldName = gr.getValue('element');
    var label     = gr.getValue('column_label');
    if (fieldName === currentField) { foundCurrent = true; }
    var sel = (fieldName === currentField) ? ' selected="selected"' : '';
    html += '<option value="' + fieldName + '"' + sel + '>'
          + label + ' (' + fieldName + ')'
          + '</option>';
  }
  if (!foundCurrent && currentField) {
    html = '<option value="' + currentField + '" selected="selected">'
         + currentField + '</option>' + html;
  }
  html;
</g:evaluate>

<div class="snc-info-page">
  <h1>Caller Phone Information</h1>

  <j:choose>
    <j:when test="${empty(jv_caller_id)}">
      <div class="snc-info-card snc-result-error">
        <h2>Missing Caller</h2>
        <p style="font-size:0.9rem;color:#637887;margin:0">
          No caller ID was provided. Open this page from the
          Incident form using the &quot;View Caller Phone&quot; UI Action.
        </p>
      </div>
    </j:when>

    <j:otherwise>
      <div class="snc-info-card">
        <h2>Select Phone Field</h2>
        <div class="snc-field-row">
          <span class="snc-field-label">sys_user field</span>
          <select id="phone-field-select">
            <g2:no_escape value="${jv_select_options}"/>
          </select>
        </div>
        <div class="snc-field-row" id="preview-row">
          <span class="snc-field-label">Current value</span>
          <span id="field-value-preview" class="snc-field-value"></span>
        </div>
      </div>

      <div class="snc-info-card">
        <h2>Caller</h2>
        <div class="snc-field-row">
          <span class="snc-field-label">Name</span>
          <span class="snc-field-value">${jv_caller_name}</span>
        </div>
        <div class="snc-field-row">
          <span class="snc-field-label">Username</span>
          <span class="snc-field-value">${jv_caller_username}</span>
        </div>
      </div>

      <button class="snc-submit-btn" id="submit-btn" type="button">Submit</button>

      <div id="submit-result">
        <div class="snc-info-card" id="result-card">
          <h2 id="result-title"></h2>
          <div id="result-body"></div>
        </div>
      </div>
    </j:otherwise>
  </j:choose>
</div>

<j:if test="${!empty(jv_caller_id)}">
<script>
(function () {
  var CALLER_ID = '${jv_caller_id}';

  var select      = document.getElementById('phone-field-select');
  var btn         = document.getElementById('submit-btn');
  var preview     = document.getElementById('field-value-preview');
  var previewRow  = document.getElementById('preview-row');
  var resultArea  = document.getElementById('submit-result');
  var resultCard  = document.getElementById('result-card');
  var resultTitle = document.getElementById('result-title');
  var resultBody  = document.getElementById('result-body');

  function loadPreview(fieldName) {
    preview.textContent = '...';
    previewRow.style.display = 'flex';
    var ga = new GlideAjax('UserPhoneInfoAjax');
    ga.addParam('sysparm_name',       'getFieldValue');
    ga.addParam('sysparm_user_id',    CALLER_ID);
    ga.addParam('sysparm_field_name', fieldName);
    ga.getXMLAnswer(function (value) {
      preview.textContent = value || '(not set)';
      preview.className   = value ? 'snc-field-value' : 'snc-field-value empty';
    });
  }

  select.addEventListener('change', function () {
    loadPreview(this.value);
    resultArea.style.display = 'none';
  });

  if (select.value) { loadPreview(select.value); }

  btn.addEventListener('click', function () {
    var fieldName = select.value;
    if (!fieldName) { return; }
    btn.disabled    = true;
    btn.textContent = 'Submitting...';
    var ga = new GlideAjax('UserPhoneInfoAjax');
    ga.addParam('sysparm_name',       'submitPhoneField');
    ga.addParam('sysparm_user_id',    CALLER_ID);
    ga.addParam('sysparm_field_name', fieldName);
    ga.getXMLAnswer(function (response) {
      btn.disabled    = false;
      btn.textContent = 'Submit';
      try {
        var data = JSON.parse(response);
        resultArea.style.display = 'block';
        if (data.success) {
          resultCard.className    = 'snc-info-card snc-result-success';
          resultTitle.textContent = 'Submitted successfully';
          resultBody.innerHTML    =
            row('User ID',     data.userId)    +
            row('Field',       data.fieldName) +
            row('Field value', data.fieldValue || '(not set)');
        } else {
          resultCard.className    = 'snc-info-card snc-result-error';
          resultTitle.textContent = 'Error';
          resultBody.innerHTML    = row('Message', data.error || 'Unknown error');
        }
      } catch (e) {
        resultArea.style.display  = 'block';
        resultCard.className      = 'snc-info-card snc-result-error';
        resultTitle.textContent   = 'Error';
        resultBody.innerHTML      = row('Message', 'Unexpected server response');
      }
    });
  });

  function row(label, value) {
    return '<div class="snc-field-row">'
      + '<span class="snc-field-label">' + label + '</span>'
      + '<span class="snc-field-value">' + value  + '</span>'
      + '</div>';
  }
}());
</script>
</j:if>

</j:jelly>]]></html>

    <client_script><![CDATA[]]></client_script>
    <processing_script><![CDATA[]]></processing_script>
  </sys_ui_page>

  <!-- ================================================================
       2. Script Include  (sys_script_include)
       ================================================================ -->
  <sys_script_include action="INSERT_OR_UPDATE">
    <sys_id>2e9c4b1d5a3f8e0c2d4b6a8e0c2d4b6a</sys_id>
    <sys_created_by>admin</sys_created_by>
    <sys_created_on>2026-04-29 00:00:00</sys_created_on>
    <sys_updated_by>admin</sys_updated_by>
    <sys_updated_on>2026-04-29 00:00:00</sys_updated_on>
    <sys_scope display_value="Global">global</sys_scope>
    <name>UserPhoneInfoAjax</name>
    <api_name>global.UserPhoneInfoAjax</api_name>
    <description>GlideAjax handler for user_phone_info. Accepts a caller sys_id (sysparm_user_id) rather than the session user. Methods: getFieldValue, submitPhoneField, getSysProperty.</description>
    <access>public</access>
    <active>true</active>
    <script><![CDATA[var UserPhoneInfoAjax = Class.create();
UserPhoneInfoAjax.prototype = Object.extendsObject(AbstractAjaxProcessor, {

    getFieldValue: function () {
        var userId    = this.getParameter('sysparm_user_id')    || '';
        var fieldName = this.getParameter('sysparm_field_name') || '';
        if (!userId || !fieldName) { return ''; }
        var gr = new GlideRecord('sys_user');
        gr.get(userId);
        return (gr.isValidRecord() ? gr.getValue(fieldName) : '') || '';
    },

    submitPhoneField: function () {
        var userId    = this.getParameter('sysparm_user_id')    || '';
        var fieldName = this.getParameter('sysparm_field_name') || '';

        if (!userId || !fieldName) {
            return JSON.stringify({ success: false, error: 'Missing required parameters.' });
        }

        var gr = new GlideRecord('sys_user');
        if (!gr.get(userId)) {
            return JSON.stringify({ success: false, error: 'User record not found.' });
        }

        var fieldValue = gr.getValue(fieldName) || '';

        // ── Add your business logic here ──────────────────────────────
        // userId     — the caller's sys_id
        // fieldValue — the value of the selected field for that caller
        // ─────────────────────────────────────────────────────────────

        return JSON.stringify({
            success:    true,
            userId:     userId,
            fieldName:  fieldName,
            fieldValue: fieldValue
        });
    },

    getSysProperty: function () {
        var propName   = this.getParameter('sysparm_prop_name')   || '';
        var defaultVal = this.getParameter('sysparm_default_val') || '';
        if (!propName) { return defaultVal; }
        return gs.getProperty(propName, defaultVal) || defaultVal;
    },

    type: 'UserPhoneInfoAjax'
});]]></script>
  </sys_script_include>

  <!-- ================================================================
       3. UI Action  (sys_ui_action)
       Table:  incident
       Type:   Client script / Form button
       For Service Operations Workspace: if surfaced as a Contextual
       Action rather than a form button, move the g_modal.showFrame()
       call into the appropriate workspace action handler.

       sys_property to create before using:
         Name:  your.incident.caller_field
         Value: caller_id   (or whatever field holds the caller sys_id)
       ================================================================ -->
  <sys_ui_action action="INSERT_OR_UPDATE">
    <sys_id>3d0e5c2f6b4a9f1e3c5d7b9e1f3a5c7e</sys_id>
    <sys_created_by>admin</sys_created_by>
    <sys_created_on>2026-04-29 00:00:00</sys_created_on>
    <sys_updated_by>admin</sys_updated_by>
    <sys_updated_on>2026-04-29 00:00:00</sys_updated_on>
    <sys_scope display_value="Global">global</sys_scope>
    <name>View Caller Phone</name>
    <table>incident</table>
    <action_name>viewCallerPhone</action_name>
    <client>true</client>
    <active>true</active>
    <form_button>true</form_button>
    <form_context_menu>false</form_context_menu>
    <list_action>false</list_action>
    <list_banner_button>false</list_banner_button>
    <onclick/>
    <condition/>
    <script><![CDATA[var ga = new GlideAjax('UserPhoneInfoAjax');
ga.addParam('sysparm_name',        'getSysProperty');
ga.addParam('sysparm_prop_name',   'your.incident.caller_field');
ga.addParam('sysparm_default_val', 'caller_id');
ga.getXMLAnswer(function (callerFieldName) {
    var callerId = g_form.getValue(callerFieldName);

    if (!callerId) {
        g_form.addErrorMessage(
            'No caller is set on this incident. Please populate the caller field first.'
        );
        return;
    }

    g_modal.showFrame(
        'Caller Phone Information',
        'user_phone_info.do?sysparm_caller_id=' + callerId,
        700,
        480
    );
});]]></script>
  </sys_ui_action>

